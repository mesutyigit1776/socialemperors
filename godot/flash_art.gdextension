[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7

[libraries]
linux.debug.x86_64 = "res://flash_art/target/release/libflash_art.so"
linux.release.x86_64 = "res://flash_art/target/release/libflash_art.so"
windows.debug.x86_64 = "res://flash_art/target/release/flash_art.dll"
windows.release.x86_64 = "res://flash_art/target/release/flash_art.dll"
macos.debug = "res://flash_art/target/release/libflash_art.dylib"
macos.release = "res://flash_art/target/release/libflash_art.dylib"
